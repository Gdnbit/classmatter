{
  "name": "@classmatter/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ClassMatter standalone synthetic desktop Demo",
  "author": "Gdnbit",
  "license": "Apache-2.0",
  "main": "main.cjs",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "node scripts/launch.cjs",
    "build:runtime": "node scripts/runtime-build.cjs",
    "start:runtime": "node scripts/runtime-launch.cjs",
    "check:runtime": "node runtime-check.cjs",
    "open:runtime": "node scripts/runtime-build.cjs && node scripts/runtime-launch.cjs",
    "build:runtime:d1": "node scripts/runtime-build.cjs --profile conversation-d1",
    "check:runtime:d1": "node runtime-check.cjs --profile conversation-d1",
    "open:runtime:d1": "node scripts/runtime-build.cjs --profile conversation-d1 && node scripts/runtime-launch.cjs --profile conversation-d1",
    "package": "node scripts/package.cjs",
    "test": "node --test tests/policy.test.cjs tests/runtime-service.test.cjs tests/runtime-check.test.cjs",
    "test:desktop": "node tests/smoke.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0",
    "playwright-core": "1.64.1"
  }
}
