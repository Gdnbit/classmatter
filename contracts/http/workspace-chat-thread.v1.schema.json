{
  "$defs": {
    "ChatThread": {
      "additionalProperties": false,
      "properties": {
        "thread_id": {
          "format": "uuid",
          "title": "Thread Id",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "archived",
            "cleared"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "cleared_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cleared At"
        }
      },
      "required": [
        "thread_id",
        "title",
        "status",
        "version",
        "created_at",
        "updated_at",
        "cleared_at"
      ],
      "title": "ChatThread",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "classmatter.workspace-chat-thread.v1",
      "default": "classmatter.workspace-chat-thread.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "thread": {
      "$ref": "#/$defs/ChatThread"
    }
  },
  "required": [
    "thread"
  ],
  "title": "ChatThreadResponse",
  "type": "object"
}
