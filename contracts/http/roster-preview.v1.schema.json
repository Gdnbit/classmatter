              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "due_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due At"
        },
        "change_due_date": {
          "default": false,
          "title": "Change Due Date",
          "type": "boolean"
        }
      },
      "required": [
        "command",
        "task_id",
        "class_id",
        "term_id",
        "expected_version",
        "status"
