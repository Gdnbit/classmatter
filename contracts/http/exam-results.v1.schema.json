      "required": [
        "student_id",
        "version",
        "status",
        "score",
        "reason",
        "created_at"
      ],
      "title": "ScoreResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "exam_id": {
      "format": "uuid",
      "title": "Exam Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    },
    "maximum_score": {
      "title": "Maximum Score",
      "type": "string"
