        "not_committed",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusReceipt"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "proposal_id",
    "payload_hash",
    "status",
    "receipt"
  ],
  "title": "CommandStatusResponse",
  "type": "object"
}
