          "title": "User Text"
        },
        "assistant_text": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Assistant Text"
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassBody"
            },
            {
              "$ref": "#/$defs/ClassEditCandidate"
            },
            {
              "$ref": "#/$defs/TermBody"
            },
            {
              "$ref": "#/$defs/StudentBody"
            },
            {
              "$ref": "#/$defs/StudentNameBody"
            },
            {
              "$ref": "#/$defs/TaskBody"
            },
            {
              "$ref": "#/$defs/TaskEditCandidate"
            },
            {
              "$ref": "#/$defs/DocumentCreate"
            },
            {
              "$ref": "#/$defs/DocumentRevise"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate"
        },
        "candidate_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Hash"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
