{
  "$defs": {
    "IdentitySubject": {
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "workspace_id"
      ],
      "title": "IdentitySubject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "class-os.identity.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "csrf_token": {
      "maxLength": 128,
      "minLength": 32,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Csrf Token",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/IdentitySubject"
    }
  },
  "required": [
    "schema_version",
    "csrf_token",
    "subject"
  ],
  "title": "IdentitySession",
  "type": "object"
}
